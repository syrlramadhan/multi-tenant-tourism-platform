# Copy to .env next to docker-compose.yml (docker compose reads it automatically).

# PostgreSQL running in Docker. The password is embedded in a connection URL,
# so use letters/digits only, e.g.: openssl rand -hex 24
POSTGRES_USER=tourism
POSTGRES_PASSWORD=
POSTGRES_DB=tourism_cms

# Signs login session cookies (min. 32 chars): openssl rand -hex 32
SESSION_SECRET=

# Port on 127.0.0.1 that Nginx proxies to.
APP_PORT=3000
