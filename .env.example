# Copy to .env.local and fill in the values from Supabase (Connect > ORMs > Prisma).
# Use the dedicated "prisma" database user; URL-encode special characters in the password (e.g. # -> %23).

# Transaction pooler (port 6543), used by the app at runtime.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432), used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Signs login session cookies (min. 32 chars). Generate with: openssl rand -hex 32
SESSION_SECRET=""
